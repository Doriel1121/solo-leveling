{
  "name": "system-rpg",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "migrate": "npm run migrate -w @system/server",
    "seed": "npm run seed -w @system/server",
    "dev": "npm run build -w @system/shared && concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @system/server",
    "dev:web": "npm run dev -w @system/web",
    "build": "npm run build -w @system/shared && npm run build -w @system/server && npm run build -w @system/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
