# ---- Server ----
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ---- Datastores ----
DATABASE_URL=postgres://system:system@localhost:5432/system_rpg
# Optional. Leave set for local Docker Redis. On Render Hobby the API falls
# back to in-process memory when this is empty (one free Key Value per workspace).
REDIS_URL=redis://localhost:6379

# ---- LLM ----
# auto = Gemini first (if keyed), then Cohere (if keyed), then the offline mock.
# gemini / cohere force that model first; the other still fails over if its key is set.
# mock skips the network entirely.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Used only for the ending still. Most Gemini *text* keys have no image quota.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Trial key from https://dashboard.cohere.com/api-keys — story/choices only, ~20 rpm.
COHERE_API_KEY=
COHERE_MODEL=command-r-08-2024

# ---- Engine tuning ----
SESSION_TTL_SECONDS=86400
CONTEXT_WINDOW=10
STATIC_NODE_RATIO=0.35
COLLISION_THRESHOLD=0.7

# ---- Web (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
